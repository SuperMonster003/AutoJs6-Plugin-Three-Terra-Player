{
  "repo_url": "https://github.com/SuperMonster003/AutoJs6-Plugin-Audio-Player",
  "repo_slug": "SuperMonster003/AutoJs6-Plugin-Audio-Player",
  "docs_autojs6_url": "https://docs.autojs6.com",
  "plugin_action": "org.autojs.plugin.EXPLORER_ACTION",
  "plugin_execute_action": "org.autojs.plugin.EXPLORER_ACTION_EXECUTE",
  "plugin_id": "audio-player",
  "plugin_engine": "explorer-action",
  "plugin_variant": "default",
  "explorer_action_ids": "play-audio (single) / play-audio-selection (multiple, up to 128)",
  "explorer_protocol_version": "12 (accepts compatible read-only v4–v12 requests)",
  "explorer_mime_types": "[audio/*]",
  "android_view_action": "android.intent.action.VIEW",
  "android_view_mime_type": "audio/* plus legacy WMA MIME aliases",
  "required_host_build": "5276",
  "supported_extensions": "aac, ac3, amr, awb, flac, m4a, m4b, m4r, mka, mp1, mp2, mp3, mpga, oga, ogg, opus, wav, wave, wma"
}
